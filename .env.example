# ==============================================================================
# BTC Options Straddle - Environment Configuration Template
# ==============================================================================
# SECURITY INSTRUCTIONS:
# 1. NEVER commit your actual '.env' file containing secrets to version control.
# 2. Copy this template to '.env' and populate your local parameters:
#      cp .env.example .env   (Linux/macOS)
#      Copy-Item .env.example .env   (Windows PowerShell)
# 3. This system operates on TESTNET ONLY. Production configurations are strictly rejected.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & EXCHANGE CONNECTIVITY CONFIGURATION (AppConfig)
# ------------------------------------------------------------------------------

# Bybit Testnet API Credentials
# Obtain testnet API keys from: https://testnet.bybit.com/
# Leave blank or commented out in DRY_RUN mode. Required when TRADING_MODE is PAPER.
BYBIT_API_KEY=your_bybit_testnet_api_key_here
BYBIT_API_SECRET=your_bybit_testnet_api_secret_here

# Network Safety Enforcement
# Enforces routing to Bybit Testnet. MUST ALWAYS BE 'true'.
# Setting this to 'false' will cause the engine to immediately abort with a SecurityError.
BYBIT_TESTNET=true

# Execution Mode: "DRY_RUN" (local simulation) or "PAPER" (orders routed to Testnet)
# Default: DRY_RUN (ensures zero unexpected orders without explicit intent)
TRADING_MODE=DRY_RUN

# In-Memory Simulation Flag: true | false
# Automatically synced with TRADING_MODE:
# When TRADING_MODE=DRY_RUN -> DRY_RUN is true
# When TRADING_MODE=PAPER   -> DRY_RUN is false
DRY_RUN=true

# System Logging Verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. STRATEGY & QUANTITATIVE RISK PARAMETERS (StrategyConfig)
# ------------------------------------------------------------------------------

# Underlying Cryptocurrency Symbol (e.g. BTC, ETH)
BTC_SYMBOL=BTC

# Order Size per Straddle Leg in BTC contracts (Must be positive float > 0.0)
ORDER_QUANTITY=0.1

# Stop-Loss Threshold Percentage (Must be 0.0 < STOP_LOSS_PERCENT <= 100.0)
# Automatically closes active straddle if total premium depreciates by this percentage.
STOP_LOSS_PERCENT=5.0

# Take-Profit Threshold Percentage (Must be float > 0.0)
# Automatically locks in profits if straddle value increases by this percentage.
TAKE_PROFIT_PERCENT=10.0

# Maximum Acceptable Quote Age in Seconds (Must be float > 0.0)
# Rejects order entry if market data quotes are older than this threshold (stale quote protection).
MAX_QUOTE_AGE_SECONDS=5.0

# Dual-Leg Execution Timeout in Seconds (Must be float > 0.0)
# If both Call and Put legs do not fill within this window, the unmatched leg policy triggers.
ENTRY_TIMEOUT_SECONDS=10.0

# Single-Leg Execution Failsafe Policy:
# Options:
#   CANCEL_AND_CLOSE -> Immediately cancel pending opposite leg and flatten the filled leg.
#   CANCEL_REMAINING -> Cancel pending leg but retain the filled leg unhedged.
#   HEDGE_ORPHAN     -> Cancel pending leg and dynamically hedge the filled leg with BTCUSDT-PERP.
UNMATCHED_LEG_POLICY=CANCEL_AND_CLOSE
