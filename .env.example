# ==============================================================================
# BTC Options Straddle - Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# 1. NEVER commit your actual '.env' file containing secrets to version control.
# 2. Copy this file to '.env' and populate your values.
# 3. This project is configured for TESTNET ONLY. Production trading is strictly refused.
# ==============================================================================

# Execution Environment: "testnet" (Default and ONLY permitted environment)
# Setting this to "production" or "mainnet" will cause the engine to immediately abort.
ENVIRONMENT=testnet

# Trading Mode: "DRY_RUN" (simulated orders without exchange placement) or "PAPER"
# Default is DRY_RUN for maximum safety.
TRADING_MODE=DRY_RUN

# Deribit Testnet Credentials (Obtain from https://test.deribit.com/)
# NEVER input live/production Deribit API keys here.
DERIBIT_CLIENT_ID=your_testnet_client_id_here
DERIBIT_CLIENT_SECRET=your_testnet_client_secret_here

# Deribit Testnet URL Endpoints
DERIBIT_TESTNET_WS_URL=wss://test.deribit.com/ws/api/v2
DERIBIT_TESTNET_HTTP_URL=https://test.deribit.com/api/v2

# Enforce Testnet safety check (must remain true)
DERIBIT_TESTNET=true

# Strategy Parameters
BTC_STRADDLE_QUANTITY=0.1
MAX_DRAWDOWN_PCT=5.0
RISK_FREE_RATE=0.04

# Logging Configuration
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_FILE_PATH=logs/straddle_engine.log
